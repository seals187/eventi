# ---------------------------------------------------------------
# eventi – configuration (copy to .env)
# Changes apply after: docker compose up -d
# (PB_VERSION requires a rebuild: docker compose up -d --build)
# ---------------------------------------------------------------

# Direct access to eventi (plain HTTP): host port and IP to bind to.
# 127.0.0.1 = only from this machine (recommended with HTTPS below),
# 0.0.0.0   = from the whole network
EVENTI_PORT=8090
EVENTI_BIND_IP=127.0.0.1

# Time zone of the container (logs, cron)
TZ=Europe/Zurich

# PocketBase superuser for the dashboard at /_/ (optional, created/updated on start)
# Password needs at least 10 characters.
PB_ADMIN_EMAIL=
PB_ADMIN_PASSWORD=

# PocketBase version used for the image build
PB_VERSION=0.40.5

# --- App ---------------------------------------------------------

# Name shown in the PocketBase dashboard
EVENTI_APP_NAME=eventi

# Fallback UI language if the browser language is not de/en/fr
EVENTI_DEFAULT_LANG=de

# Max. participants per survey
EVENTI_MAX_RESPONSES=100

# Delete surveys without activity after N days (0 = never)
EVENTI_RETENTION_DAYS=0

# --- Protection --------------------------------------------------

# Rate limiting per IP (true/false)
EVENTI_RATE_LIMIT=true
# New surveys per minute
EVENTI_RATE_LIMIT_CREATE=10
# API requests per minute
EVENTI_RATE_LIMIT_API=120

# Behind a reverse proxy: header carrying the client IP, e.g. X-Forwarded-For
# Leave empty when the container is reached directly.
# With HTTPS (Caddy) below: X-Forwarded-For
EVENTI_TRUSTED_PROXY_HEADER=

# --- HTTPS (Caddy, own certificate, LAN only) ----------------------
# Example values – adjust, then uncomment COMPOSE_PROFILES to enable.
# Put fullchain.pem (cert + intermediates) and privkey.pem into EVENTI_CERT_DIR.

# Enables the caddy service in docker-compose.yml
#COMPOSE_PROFILES=https

# Hostname covered by the wildcard (one level only: eventi.example.ch, not a.b.example.ch).
# Point it to the host's internal IP in your internal DNS.
EVENTI_DOMAIN=eventi.example.ch

# Internal IP of the host Caddy listens on (80/443). Never 0.0.0.0 on a host with a public interface.
EVENTI_HTTPS_BIND_IP=192.168.1.10

# Allowed client networks (space separated CIDRs); private_ranges = 10/8, 172.16/12, 192.168/16, localhost
EVENTI_ALLOWED_IPS=private_ranges
#EVENTI_ALLOWED_IPS=192.168.1.0/24 10.8.0.0/24

# Folder with fullchain.pem and privkey.pem
EVENTI_CERT_DIR=./certs
