# eventi – HTTPS reverse proxy with your own (wildcard) certificate, LAN only.
# Values come from .env: EVENTI_DOMAIN, EVENTI_ALLOWED_IPS
# Certificate files (PEM) in ./certs: fullchain.pem (cert + intermediates), privkey.pem

{$EVENTI_DOMAIN} {
	tls /certs/fullchain.pem /certs/privkey.pem

	# Drop everything that is not from an allowed network
	@blocked not remote_ip {$EVENTI_ALLOWED_IPS:private_ranges}
	abort @blocked

	# Optional: hide the PocketBase dashboard
	# @dashboard path /_/ /_/*
	# respond @dashboard 404

	# Realtime (SSE) is flushed automatically by reverse_proxy
	reverse_proxy eventi:8090
}
